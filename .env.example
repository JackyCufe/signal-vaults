# Signal Vaults 配置模板
# 复制为 .env 后填写；不要把真实 .env 提交到 Git。

# LLM 后端：auto=有 API key 走 API，否则走已登录的 Codex CLI；也可填 api/codex
LLM_BACKEND=auto

# 使用 Codex CLI 时可留空；也可填写 codex.ps1/codex.exe 的完整路径和模型
CODEX_BIN=
CODEX_MODEL=
CODEX_PROXY=

# 使用 API 后端时填写以下配置；Codex 后端不需要 LLM_API_KEY
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_PROXY=

# Discord 推送
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
PUSH_PROXY=

# 外部信息源 (signal-vaults hn / reddit)
# HN: 免费, 无需配置
# Reddit: 国内需代理 (可复用 PUSH_PROXY)
REDDIT_PROXY=

# 飞书 Bot (WebSocket 长连接, 可双向交互: 群里发"日报/hn/reddit"触发)
# 获取: open.feishu.cn → 开发者后台 → 创建企业自建应用 → 凭证页拿 ID/Secret
# 权限: im:message; 事件订阅选"长连接" + 添加 im.message.receive_v1; 发布后拉 bot 进群
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TARGET_CHAT=
# 主题/风格定制 (对所有信息源生效)
# SIG_VAULTS_TOPIC=机器人具身智能
# SIG_VAULTS_STYLE=每条一句话, 语气直接
# 消息溯源: 1=日报每条知识点附原始聊天上下文(折叠块), 0/不填=关闭
SIG_VAULTS_TRACE=0
